# pat-frontend — local + Fly env vars.
#
# Token the page-load grant — anyone who hits the dashboard URL with this
# token in `?token=` gets read-only monitor access.
PAT_VIEWER_TOKEN=

# Token used by the SSE proxy to authenticate TO nanoclaw. Kept separate
# so it can rotate independently from the viewer token.
PAT_ADMIN_TOKEN=

# Upstream nanoclaw admin/observatory port. On Fly, set to
# "pat-nanoclaw.internal:8767" (default in fly.toml). Locally, point at
# your dev nanoclaw's admin port — e.g. http://localhost:8767.
# (Was 8765 before R10 split admin onto its own listener.)
NANOCLAW_INTERNAL_HOST=pat-nanoclaw.internal:8767
NANOCLAW_INTERNAL_SCHEME=http

# Server bind port.
PORT=8787

# Clerk publishable key — PUBLIC_ tier: runtime-injected into the page as
# window.__PUBLIC_ENV__.CLERK_PUBLISHABLE_KEY (server/public-env.ts). On Fly set
# it as a secret: `fly secrets set PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...`. No build-arg.
PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk server-side keys (@clerk/hono).
CLERK_SECRET_KEY=
