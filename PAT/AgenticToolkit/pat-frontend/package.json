{
  "name": "pat-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "//trustedDependencies": "Intentionally empty. better-sqlite3 is the Node/vitest fallback only — the bun server uses bun:sqlite (builtin), so we do NOT want bun to compile better-sqlite3's native binding during `bun install` (it needs python/node-gyp, absent from the Docker image, and the binding is never loaded under bun anyway). LOCAL test runs that need the binding: `npm_config_ignore_scripts=false npm rebuild better-sqlite3 --foreground-scripts`.",
  "trustedDependencies": [],
  "scripts": {
    "dev": "vite",
    "dev:server": "bun run --hot server/index.ts",
    "build": "bun scripts/check-renderers.ts && tsc -b && vite build",
    "build:check": "tsc -b --noEmit",
    "preview": "vite preview",
    "start": "bun run server/index.ts",
    "typecheck": "tsc -b --noEmit",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/backend": "^3.7.1",
    "@clerk/hono": "^0.1.37",
    "@clerk/react": "^6.10.0",
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/dm-sans": "^5.2.8",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "1.1.13",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "8.21.3",
    "better-sqlite3": "11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hono": "^4.6.20",
    "lucide-react": "^1.20.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "20.8.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "4.1.4"
  }
}
