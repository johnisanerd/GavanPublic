# NanoClaw v2 host image for Fly.io.
#
# Runs the host process (Node) AND a dockerd inside the same Fly
# Machine, so nanoclaw can `docker run` per-session agent containers.
# Fly Machines are Firecracker microVMs, so dockerd here is at the
# kernel level — no nested-virtualization tricks, no privileged flag.
#
# Build context: agentic_toolkit/ (parent of nanoclaw/) so we can
# include the sibling realtime/ package that nanoclaw depends on via
# `file:../realtime`. Deploy from the toolkit root with:
#   fly deploy -c fly.nanoclaw.toml --remote-only
#
# Layout inside the running machine:
#   /app/realtime    — image-baked realtime library (built dist/)
#   /app/nanoclaw    — image-baked nanoclaw checkout (immutable)
#   /workspace       — symlink → /data/nanoclaw (volume-backed)
#   /data            — Fly Volume mount (nanoclaw + dockerd state)
#   /data/nanoclaw   — sessions, group folders, central DB, logs
#   /data/docker     — dockerd's data-root (set in daemon.json)

FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:/usr/local/bin:$PATH

# ---- system packages -------------------------------------------------------
# docker.io: bundles dockerd + docker CLI + containerd + runc, all glibc-built.
# tini: PID-1 signal forwarding so SIGTERM from Fly properly cascades.
# iptables/iproute2: dockerd needs them to set up bridge networking.
# ca-certificates + curl: TLS for OneCLI install + Anthropic API.
# git: nanoclaw self-mod hooks may shell out to it.
# python3: better-sqlite3 / native deps fall back to gyp builds; harmless if unused.
# ffmpeg: signal.ts uses it to transcode Cartesia Sonic mp3 output to
# opus/ogg for outbound Signal voice memos (task #15) — Signal's native
# voice-note format is opus-in-ogg, Cartesia's TTS only emits raw/wav/mp3.
# (Inbound STT no longer needs ffmpeg as of task #37: OpenRouter Whisper
# accepts raw AAC directly. ~50MB image growth still worth it for outbound.)
RUN apt-get update && apt-get install -y --no-install-recommends \
        docker.io \
        tini \
        ca-certificates \
        curl \
        ffmpeg \
        git \
        iptables \
        iproute2 \
        openssl \
        procps \
        python3 \
        sqlite3 \
        sudo \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# Docker Compose v2 plugin. Required by the OneCLI gateway installer
# (`onecli.sh/install` runs `docker compose up -d`); Debian's docker.io
# package only ships v1 (`docker-compose`, hyphenated, separate binary)
# which the OneCLI script doesn't accept.
RUN mkdir -p /usr/libexec/docker/cli-plugins \
    && curl -fsSL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64 \
       -o /usr/libexec/docker/cli-plugins/docker-compose \
    && chmod +x /usr/libexec/docker/cli-plugins/docker-compose \
    && docker compose version

# ---- pnpm + OneCLI CLI -----------------------------------------------------
# pnpm: nanoclaw's package manager. Pin to project's declared packageManager
# (10.33.0 in nanoclaw/package.json) to keep lockfile resolution stable.
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# OneCLI CLI binary. The gateway runs as a docker container, started by the
# entrypoint after dockerd is up. CLI binary is needed at build time so we
# can install the gateway docker image at runtime via `onecli install`.
RUN curl -fsSL https://onecli.sh/cli/install | sh \
    && onecli version

# ---- daemon.json -----------------------------------------------------------
# Configure dockerd's data-root so per-session containers and image layers
# live on the Fly Volume (persists across machine restarts). Without this
# they go to /var/lib/docker on the ephemeral root fs and disappear on
# every redeploy — agent images would rebuild on every cold start (~2min).
COPY <<'EOF' /etc/docker/daemon.json
{
  "data-root": "/data/docker",
  "storage-driver": "overlay2",
  "log-driver": "json-file",
  "log-opts": { "max-size": "10m", "max-file": "3" },
  "iptables": true,
  "bridge": "docker0",
  "dns": ["8.8.8.8", "1.1.1.1"],
  "features": { "buildkit": true }
}
EOF

# ---- realtime library (sibling workspace dep) -----------------------------
# nanoclaw's package.json has `"@agentic-toolkit/realtime": "file:../realtime"`,
# so we have to install + build realtime FIRST. pnpm picks up its already-
# built dist/ when nanoclaw resolves the file: link.
WORKDIR /app/realtime
COPY realtime/package.json realtime/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY realtime/tsconfig.json ./
COPY realtime/src ./src
RUN pnpm run build

# ---- scenarios library (sibling workspace dep) ----------------------------
# nanoclaw's package.json has `"@agentic-toolkit/scenarios": "file:../scenarios"`,
# so the directory must exist at /app/scenarios with a built dist/ before
# nanoclaw's pnpm install runs (the file: link resolves via package.json's
# main → dist/index.js). scenarios uses bun (bun.lock) but we ship the
# pre-built dist as-is rather than installing bun in this host image.
# Local dev's scripts/dev.sh rebuilds scenarios/dist before starting,
# so it's expected to be fresh on every deploy.
COPY scenarios /app/scenarios

# ---- pat-prompts (install-wide PAT markdown read at runtime) --------------
# container-runner.ts:330 resolves `path.resolve(process.cwd(), '..', 'pat-prompts')`
# — i.e. /app/pat-prompts at runtime. Tracked in the parent repo (not nanoclaw
# sub-repo); copied in so the image is self-contained.
COPY pat-prompts /app/pat-prompts

# ---- nanoclaw source + build ----------------------------------------------
WORKDIR /app/nanoclaw

# Manifest first for cache-friendly rebuilds. Source changes don't
# invalidate `pnpm install` if package.json/lockfile haven't changed.
COPY nanoclaw/package.json nanoclaw/pnpm-lock.yaml nanoclaw/pnpm-workspace.yaml ./
# patches/ holds pnpm-managed package overrides (referenced from
# pnpm-workspace.yaml's patchedDependencies). pnpm install reads these
# at install time, so they must land before the install step.
COPY nanoclaw/patches ./patches
RUN pnpm install --frozen-lockfile

# Now the rest of the source.
COPY nanoclaw/tsconfig.json ./
COPY nanoclaw/src ./src
COPY nanoclaw/setup ./setup
COPY nanoclaw/scripts ./scripts
COPY nanoclaw/container ./container
COPY nanoclaw/assets ./assets
COPY nanoclaw/config-examples ./config-examples
# Skill files are installed at runtime via /add-* skills, not at image build
# (keeps the image small and lets us pick channels per environment).

# Compile TypeScript → /app/nanoclaw/dist.
RUN pnpm run build

# ---- entrypoint ------------------------------------------------------------
# Copy from the already-baked /app/nanoclaw/scripts (populated by step 19's
# COPY nanoclaw/scripts ./scripts) instead of pulling from build context
# again. The duplicate context reference reliably triggers a BuildKit
# cache-key failure on subsequent deploys (`/nanoclaw/scripts/fly-entrypoint.sh:
# not found`) — two different COPY commands fighting over the same path
# in the per-deploy context snapshot. Using `cp` sidesteps it.
RUN cp /app/nanoclaw/scripts/fly-entrypoint.sh /usr/local/bin/fly-entrypoint \
 && chmod +x /usr/local/bin/fly-entrypoint

EXPOSE 8765
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/fly-entrypoint"]
CMD []
