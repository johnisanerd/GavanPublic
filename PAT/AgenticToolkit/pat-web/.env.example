# pat-web environment — copy to .env (gitignored) for local dev.
# The canonical source of these values is the repo-root .env.agent file.

# Anam API key — base64("<key-id>:<secret>") form, as issued by Anam.
ANAM_API_KEY=

# Default persona — used for both demo mode and PAT mode.
# For chroma-key to look good you'll want a green-screen avatar created in
# Anam Lab. Stock avatars work fine with the vignette but not chroma.
ANAM_AVATAR_ID=
ANAM_VOICE_ID=

# Anam default brain — used by "demo" mode so the entire UI can be
# exercised without the PAT banter backend. Override only if you want a
# specific stock LLM id; otherwise the server falls back to a sensible
# default. Anam docs list ids at /docs/personas/llms/available-llms.
ANAM_DEFAULT_LLM_ID=

# Server-side ports.
PORT=8788

# Upstream nanoclaw anam-web channel adapter URL.
#   Local dev (default):  http://127.0.0.1:8766
#   Fly prod:             http://pat-nanoclaw.internal:8766
# server/index.ts also defaults to the local value when this var is
# unset, so leaving it blank in dev works. Set explicitly for prod.
NANOCLAW_ANAM_WEB_URL=http://127.0.0.1:8766
