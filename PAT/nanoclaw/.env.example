# nanoclaw env — copy to .env (gitignored) for local dev.

# ── anam-web channel (HTTP backend for pat-web's Anam.ai frontend) ──
# Required: the agent_group_id that should answer anam-web inbound. On
# first visit, the channel auto-creates the messaging_group + wiring +
# agent_destinations row against this id. No seed mg required (was
# required pre-2026-05-12). Look up via:
#   sqlite3 data/v2.db "SELECT id, name FROM agent_groups"
ANAM_WEB_DEFAULT_AGENT_GROUP_ID=

# Optional: where the channel HTTP server binds (default 127.0.0.1 for
# local dev — fine for pat-web on the same host). Set to `::` to expose
# on the IPv6 wildcard, e.g. when nanoclaw runs in a container and
# pat-web is on the host. Prod Fly sets this in fly.nanoclaw.toml [env].
# ANAM_WEB_BIND_HOST=::
# ANAM_WEB_CHANNEL_PORT=8766
