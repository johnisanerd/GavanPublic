# Neon Postgres (Vercel Marketplace integration provides these)
DATABASE_URL=

# Typeform webhook signing secret (set per-form when creating the webhook)
TYPEFORM_WEBHOOK_SECRET=

# Typeform Personal Access Token (for Responses API enrichment)
TYPEFORM_API_TOKEN=

# Prolific API token (for submission/demographic enrichment by SESSION_ID,
# AND for resolving study completion codes in the /completed flow).
PROLIFIC_API_TOKEN=

# Canonical public app URL (used by /completed thank-you page). Defaults to
# https://the-test.org if unset.
NEXT_PUBLIC_APP_URL=https://the-test.org

# ElevenLabs Scribe — re-transcribe Typeform voice answers (better than Typeform's).
ELEVENLABS_API_KEY=

# AI Gateway (for later: LLM rubric scoring). One key, many providers.
AI_GATEWAY_API_KEY=

# Model override for testing — forces all model categories to one cheap model.
# AI_MODEL=
# EFFORT=low
