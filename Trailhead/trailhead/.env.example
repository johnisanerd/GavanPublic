# =============================================================================
# OpenRouter API Key (single key for all LLM providers)
# =============================================================================

OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here

# =============================================================================
# AI Model Configuration
# =============================================================================

# Utility models (for summarization, analysis, and other internal tasks)
UTILITY_MODEL=anthropic/claude-sonnet-4
FAST_UTILITY_MODEL=anthropic/claude-3-5-haiku

# Default model for experiments when user gives no guidance
DEFAULT_EXPERIMENT_MODEL=anthropic/claude-sonnet-4

# Rate limiting for AI calls
AI_CALLS_PER_SECOND=5
AI_MAX_QUEUE=50

# =============================================================================
# Slack Configuration
# =============================================================================

SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# Bot persona (optional)
# Icon URL must be publicly accessible (e.g., hosted on CDN, Slack file storage)
BOT_NAME=Trailhead
BOT_ICON_URL=

# =============================================================================
# Application Configuration
# =============================================================================

# Request timeout in seconds
TIMEOUT_S=20.0

# Maximum tokens for research content
MAX_RESEARCH_TOKENS=25000

# Directory where experiment logs are stored
RUNNER_LOG_DIR=logs

# Base URL for constructing viewer links (e.g., https://trailhead.railway.app)
APP_BASE_URL=http://localhost:8000

# =============================================================================
# Development/Debug Options
# =============================================================================

# Dry run mode (skip actual AI calls)
DRY_RUN=false

# Enable streaming responses
USE_STREAMING=false

# Allow non-Slack requests to /summarize and /run endpoints
ACCEPT_NON_SLACK_REQUESTS=false

# =============================================================================
# Ranger Autonomous Research Agent
# =============================================================================

# E2B API key for running Claude Code sandboxes
E2B_API_KEY=

# Anthropic API key (passed to Claude Code in sandbox)
ANTHROPIC_API_KEY=

# Secret for Ranger MCP authentication (separate from TRAILHEAD_SECRET)
RANGER_SECRET=

# Slack channel ID for Ranger session updates (optional)
# If not set, Ranger won't post to Slack
RANGER_SLACK_CHANNEL=

# =============================================================================
# MCP Server Authentication
# =============================================================================

# Secret for general MCP access (Claude Code, other MCP clients)
TRAILHEAD_SECRET=
